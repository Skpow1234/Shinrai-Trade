# Copy to `.env` for local tools that read dotenv (never commit `.env`).
# Dev-only defaults — match `compose.yaml`. Do not use in production.

# PostgreSQL (Phase 3.5+ / durable OMS)
SHINRAI_DATABASE_URL=postgres://shinrai:shinrai@127.0.0.1:5432/shinrai
SHINRAI_DB_POOL_SIZE=5
# When set, order gateway runs embedded migrations on start (dev)
SHINRAI_RUN_MIGRATIONS=1

# Market-data gateway
# SHINRAI_MD_BIND=127.0.0.1:8080
# SHINRAI_MD_TOKENS=dev:alice
# SHINRAI_MD_CLIENTS=dev:s3cret:alice
# SHINRAI_MD_SYNTH=1
# Live Coinbase Exchange public feed (BTC-USD). Prefer over SYNTH when both set.
# SHINRAI_MD_COINBASE=1

# Optional: order gateway ↔ market-data gateway live marks
# SHINRAI_OG_MD_URL=http://127.0.0.1:8080
# SHINRAI_OG_MD_TOKEN=dev
# Pending OMS age (logical seconds) before /v1/ops reports stuck
# SHINRAI_OG_STUCK_AGE_SECS=5
# Venue: sim (default), sandbox, rest/http, or licensed (logon/heartbeat session)
# SHINRAI_OG_VENUE=sandbox
# SHINRAI_OG_VENUE=rest
# SHINRAI_OG_VENUE=licensed
# SHINRAI_OG_VENUE=fix
# SHINRAI_OG_VENUE=alpaca
# Local FIX 4.2 subset (when SHINRAI_OG_VENUE=fix) — in-process; no TCP yet
# SHINRAI_OG_FIX_SENDER_COMP_ID=SHINRAI
# SHINRAI_OG_FIX_TARGET_COMP_ID=SIM
# SHINRAI_OG_FIX_HEARTBEAT_SECS=5
# SHINRAI_OG_FIX_AUTO_FILL=true
# Alpaca paper Trading API (when SHINRAI_OG_VENUE=alpaca)
# SHINRAI_OG_ALPACA_KEY=
# SHINRAI_OG_ALPACA_SECRET=
# SHINRAI_OG_ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Paper trader UI — easiest path:
#   cargo run -p shinrai-order-gateway -- --dev
#   open http://127.0.0.1:8081/ui   (token: dev)
# Or: ./scripts/dev-ui.sh  |  .\scripts\dev-ui.ps1  |  scripts\dev-ui.cmd
# SHINRAI_OG_DEV=1
# Optional ops bearer for /v1/ops* and /v1/metrics
# SHINRAI_OG_OPS_TOKEN=ops-dev-secret
# Ops IP allowlist (comma-separated IPs/CIDRs; * = any). Empty = open.
# SHINRAI_OG_OPS_ALLOWLIST=127.0.0.1,10.0.0.0/8
# Remote REST paper/broker when SHINRAI_OG_VENUE=rest
# SHINRAI_OG_REST_URL=https://paper-broker.example/v1
# SHINRAI_OG_REST_TOKEN=
# Fail-hard on Postgres write-through (default on when DB URL set). Set 0 for fail-soft chaos.
# SHINRAI_OG_STORE_FAIL_HARD=1
# KYC gate: subject:status,... (approved|pending|rejected). Empty = all approved.
# SHINRAI_OG_KYC_STATUS=alice:approved,bob:pending
# Optional KYC HTTP vendor: GET {url}/{subject} → {"status":"approved"}
# SHINRAI_OG_KYC_VENDOR_URL=http://127.0.0.1:8099/kyc
# SHINRAI_OG_KYC_VENDOR_TOKEN=
# SHINRAI_OG_KYC_VENDOR_TIMEOUT_MS=2000
# SHINRAI_OG_KYC_VENDOR_CACHE_SECS=60
# Phase 5 paper fund movements (ledger only — not bank/broker rails)
# SHINRAI_OG_FUNDS_ENABLED=1
# SHINRAI_OG_WITHDRAWALS_ENABLED=1
# SHINRAI_OG_WITHDRAW_APPROVAL_THRESHOLD_MINOR=100000
# Audit export: HMAC-SHA256 key + optional retention window (logical seconds)
# SHINRAI_OG_AUDIT_EXPORT_HMAC_KEY=
# SHINRAI_OG_AUDIT_EXPORT_RETENTION_SECS=86400
# Bootstrap restricted symbols (comma-separated)
# SHINRAI_OG_RESTRICTED_SYMBOLS=AAPL
# Admin override bearer (header X-Admin-Override) for restricted instruments
# SHINRAI_OG_ADMIN_OVERRIDE_TOKEN=override-dev
# Optional mTLS for order-gateway → market-data-gateway quotes
# SHINRAI_OG_MD_CLIENT_CERT=/path/client.crt.pem
# SHINRAI_OG_MD_CLIENT_KEY=/path/client.key.pem
# SHINRAI_OG_MD_CA=/path/ca.pem
# Pre-trade risk overlays (applied on demo limits at OG startup)
# SHINRAI_RISK_COLLAR_BPS=100
# SHINRAI_RISK_MAX_DAILY_LOSS_MINOR=50000
# SHINRAI_RISK_MAX_ASSET_CLASS_NOTIONAL_MINOR=1000000
# SHINRAI_RISK_MARKET_SESSION=48600:72000
# SHINRAI_RISK_ALLOW_SHORT=0
# SHINRAI_RISK_MAX_SHORT_LOTS=0

# Tracing / OpenTelemetry (order gateway)
# SHINRAI_LOG=info,shinrai_order_gateway=debug,shinrai_paper=debug
# SHINRAI_OTEL_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Outbox publisher poll (ms) when Postgres is enabled
# SHINRAI_OUTBOX_POLL_MS=1000
# Optional NATS event bus (unset = log sink only)
# SHINRAI_NATS_URL=nats://127.0.0.1:4222
# SHINRAI_NATS_SUBJECT_PREFIX=shinrai
